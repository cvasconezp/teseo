# Copia este archivo a .env y completa tu key real.
# NUNCA subas el archivo .env (con tu key real) a GitHub — está en .gitignore.

# Crea una cuenta gratis en https://console.groq.com para obtener tu key.
GROQ_API_KEY=tu_groq_api_key_aqui

# Modelo Groq para la narrativa (opcional). Por defecto: openai/gpt-oss-120b.
# Vigentes: openai/gpt-oss-120b y openai/gpt-oss-20b. Groq retiró los
# llama-3.x (16-ago-2026) y groq/compound (21-sep-2026): dan 404.
# Ver https://console.groq.com/docs/deprecations
# GROQ_MODEL=openai/gpt-oss-120b

# ── Opcionales ──────────────────────────────────────────────────────────
# Clave de Launch Library 2 (The Space Devs). Sin clave: 15 peticiones/hora
# por IP, suficiente porque el backend cachea 30 min. https://thespacedevs.com/llapi
# LL2_API_KEY=

# User-Agent con el que el backend se identifica ante NASA/JPL. Su política
# de uso lo pide para procesos automáticos: producto, versión y contacto.
# TESEO_USER_AGENT=Teseo/0.2 (+https://tu-sitio; tu-correo@dominio)

# Orígenes permitidos por CORS, separados por comas (por defecto: todos).
# ALLOWED_ORIGINS=https://tu-dominio

# Precarga de datos al arrancar (1 = sí, por defecto; 0 = no, útil en pruebas).
# TESEO_PREWARM=1

# ── Panel de métricas (#admin) ──────────────────────────────────────────
# Clave del panel. Sin ella el panel queda cerrado (no abierto).
# Genera una larga y aleatoria: python -c "import secrets; print(secrets.token_urlsafe(32))"
# TESEO_METRICS_TOKEN=
# Carpeta donde se guardan los contadores (en Railway: un volumen).
# TESEO_METRICS_DIR=
# TESEO_METRICS_RATE_PER_MIN=
# TESEO_METRICS_UTC_OFFSET_HOURS=-5

# ── Recordatorios push («Recordarme») ───────────────────────────────────
# Par de claves VAPID. Sin ellas /api/push/key responde 503 y la app oculta
# los recordatorios. La privada es un secreto: solo en el panel de Railway.
# TESEO_VAPID_PUBLIC=
# TESEO_VAPID_PRIVATE=
# TESEO_VAPID_SUBJECT=mailto:tu-correo@dominio
# TESEO_PUSH_DIR=
# TESEO_PUSH_LOOP=1

# Carpeta de la caché del planificador de catapultas (MGA).
# TESEO_MGA_DIR=

# ── Límites contra el abuso (por IP) ────────────────────────────────────
# Los valores por defecto son holgados a propósito: en una charla o un aula
# mucha gente comparte la misma IP. Súbelos antes de un evento grande.
# Rutas caras (horizonte, relieve, nubes, trayectorias…) por minuto; 0 = sin límite.
# TESEO_API_RATE_PER_MIN=600
# Narraciones nuevas de Groq por minuto (las repetidas salen de la caché).
# TESEO_AI_RATE_PER_MIN=20
# Suscripciones nuevas a recordatorios por día.
# TESEO_PUSH_NEW_PER_IP_DAY=200

# Documentación interactiva de la API (/docs y /openapi.json). En producción: 0.
# TESEO_DOCS=1
