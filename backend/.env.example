# Copia este archivo a .env y completa tu key real.
# NUNCA subas el archivo .env (con tu key real) a GitHub — está en .gitignore.

# Crea una cuenta gratis en https://console.groq.com para obtener tu key.
GROQ_API_KEY=tu_groq_api_key_aqui

# Modelo Groq para la narrativa (opcional). Por defecto: openai/gpt-oss-120b.
# En plan developer están disponibles: openai/gpt-oss-120b, openai/gpt-oss-20b,
# groq/compound, groq/compound-mini. Ojo: los llama-3.x pasaron a Enterprise
# (dan 404 en cuentas developer). Ver https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b

# ── Opcionales ──────────────────────────────────────────────────────────
# Clave de Launch Library 2 (The Space Devs). Sin clave: 15 peticiones/hora
# por IP, suficiente porque el backend cachea 30 min. https://thespacedevs.com/llapi
# LL2_API_KEY=

# User-Agent con el que el backend se identifica ante NASA/JPL. Su política
# de uso lo pide para procesos automáticos: producto, versión y contacto.
# TESEO_USER_AGENT=Teseo/0.2 (+https://tu-sitio; tu-correo@dominio)

# Orígenes permitidos por CORS, separados por comas (por defecto: todos).
# ALLOWED_ORIGINS=https://tu-dominio

# Precarga de datos al arrancar (1 = sí, por defecto; 0 = no, útil en pruebas).
# TESEO_PREWARM=1
